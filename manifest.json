{
  "format": 2,
  "api": "0.2",
  "id": "spool.emby",
  "name": "Emby",
  "version": "0.1.2",
  "publisher": "Spool",
  "summary": "Your Emby server",
  "homepage": "https://github.com/spool-player/spool-emby",
  "icon": "assets/icon.png",
  "entry": "logic/provider.mjs",
  "capabilities": ["search", "userState", "reporting", "segments", "streamQuality", "discovery", "remoteControl"],
  "extensions": {"spool.artwork-owners": 1, "spool.speed-test": 1, "spool.lan-probe": 1,
    "spool.suggestions": 1, "spool.item-actions": 1, "spool.collection-editing": 1,
    "spool.playback-queue-reporting": 1, "spool.playback-preferences": 1, "spool.settings-storage": 1,
    "spool.remote-targets": 1},
  "origins": ["https://connect.emby.media"],
  "ui": {
    "login": "ui/Login.qml",
    "picker": "ui/Picker.qml",
    "settings": "ui/Settings.qml"
  },
  "actions": [
    {"id": "playlist", "label": "Add to playlist", "icon": "playlist_add",
      "types": ["Movie", "Episode", "Series", "Season", "Audio", "MusicAlbum", "MusicVideo", "Video"]},
    {"id": "collection", "label": "Add to collection", "icon": "library_add", "types": ["Movie", "Series"]},
    {"id": "rename", "label": "Rename", "icon": "drive_file_rename_outline", "types": ["Playlist", "BoxSet"]},
    {"id": "delete", "label": "Delete from server", "icon": "delete"}
  ]
}
